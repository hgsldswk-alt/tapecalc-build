    "proFeatures": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建立多份纸带、使用空白模板，并导出 CSV 或可编辑纸带。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create more tapes, start from blank templates, and export CSV or editable tapes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立多份紙帶、使用空白範本，並匯出 CSV 或可編輯紙帶。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストを増やしたり、空のテンプレートから始めたり、CSVや編集できるリストを書き出せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테이프를 더 만들고, 빈 템플릿으로 시작하고, CSV나 편집 가능한 테이프로 내보내세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle mehr Rollen, starte mit leeren Vorlagen und exportiere CSV oder bearbeitbare Rollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea más cintas, empieza con plantillas en blanco y exporta CSV o cintas editables."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée plus de rubans, pars de modèles vierges et exporte en CSV ou en ruban modifiable."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie mais fitas, comece com modelos em branco e exporte em CSV ou fita editável."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea più nastri, parti da modelli vuoti ed esporta in CSV o nastro modificabile."
          }
        }
      }
    },
    "trialTerms": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次打开起试用 30 天，到期不会自动扣费。已有纸带仍可编辑、复制和分享，也可继续免费导入文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Pro for 30 days from first launch. There is no automatic charge. You can still edit, copy and share saved tapes, and import files for free."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首次開啟起試用 30 天，到期不會自動扣款。已有紙帶仍可編輯、複製與分享，也可繼續免費匯入檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初めて起動してから30日間Proをお試しいただけます。自動課金はありません。保存したリストの編集・コピー・共有とファイルの取り込みは無料で続けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음 실행한 날부터 30일 동안 Pro를 써 보세요. 자동 결제는 없습니다. 저장한 테이프 편집, 복사, 공유, 파일 가져오기는 계속 무료입니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teste Pro 30 Tage ab dem ersten Start. Es wird nichts automatisch abgebucht. Gespeicherte Rollen kannst du weiter bearbeiten, kopieren und teilen und Dateien kostenlos importieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba Pro 30 días desde el primer uso. No hay cobro automático. Puedes seguir editando, copiando y compartiendo cintas guardadas e importar archivos gratis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essaie Pro pendant 30 jours dès la première ouverture. Aucun paiement automatique. Tu peux toujours modifier, copier et partager les rubans enregistrés, et importer des fichiers gratuitement."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente o Pro por 30 dias desde a primeira abertura. Sem cobrança automática. Você continua podendo editar, copiar e compartilhar fitas salvas, e importar arquivos de graça."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova Pro per 30 giorni dalla prima apertura. Nessun addebito automatico. Puoi sempre modificare, copiare e condividere i nastri salvati e importare file gratis."
          }
        }
      }
    },
