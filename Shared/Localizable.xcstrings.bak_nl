    "privacyBody": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纸带仅保存在设备上。应用无需账号，不含广告和统计。仅在你主动操作时读取剪贴板或分享内容。购买与恢复由 App Store 处理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapes are stored on this device. There are no accounts, ads or analytics. Clipboard access and sharing happen when you choose them. The App Store handles purchases and restoration."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紙帶僅儲存在裝置上。App 無需帳號，沒有廣告與統計。僅在你主動操作時讀取剪貼簿或分享內容。購買與復原由 App Store 處理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストはこの端末内に保存されます。アカウント、広告、分析ツールはありません。クリップボードへのアクセスと共有は、操作したときだけ行われます。購入と復元はApp Storeが処理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테이프는 이 기기에 저장됩니다. 계정, 광고, 분석이 없습니다. 클립보드 접근과 공유는 직접 고를 때만 일어납니다. 구매와 복원은 App Store가 처리합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rollen werden auf diesem Gerät gespeichert. Kein Konto, keine Werbung, keine Analyse. Zwischenablage und Teilen werden nur genutzt, wenn du sie auswählst. Käufe und Wiederherstellung laufen über den App Store."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cintas se guardan en este dispositivo. Sin cuentas, sin anuncios, sin analíticas. El portapapeles y compartir solo se usan cuando tú lo eliges. El App Store gestiona compras y restauración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rubans sont stockés sur cet appareil. Pas de compte, de publicité ni d’analyse. L’accès au presse-papiers et le partage n’ont lieu que quand tu le choisis. L’App Store gère les achats et les restaurations."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fitas ficam armazenadas neste dispositivo. Sem contas, anúncios ou análises. O acesso à área de transferência e o compartilhamento só acontecem quando você escolhe. A App Store cuida das compras e restaurações."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nastri restano su questo dispositivo. Nessun account, pubblicità o analisi. L’accesso agli appunti e la condivisione avvengono solo quando lo scegli. L’App Store gestisce acquisti e ripristini."
          }
        }
      }
    },
